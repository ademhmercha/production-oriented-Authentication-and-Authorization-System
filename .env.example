# ============ Runtime ============
NODE_ENV=development
SERVICE_NAME=auth-server
PORT=3001
LOG_LEVEL=info

# ============ Persistence ============
DATABASE_URL=postgres://identity:change_me_dev_password@localhost:5432/identity
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ============ Tokens / JWT (seconds) ============
JWT_ISSUER=https://auth.local
JWT_AUDIENCE=api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
AUTHORIZATION_CODE_TTL=120
ID_TOKEN_TTL=3600
SESSION_TTL=2592000

# ============ Key management ============
# local = LocalKeyProvider (dev). In production swap for aws-kms / azure-kv / gcp-kms / vault.
KMS_PROVIDER=local
KMS_KEY_DIR=./keys
# Base64-encoded 32-byte master key used by LocalKeyProvider to wrap signing keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MASTER_KEY=

# ============ Passwords ============
PASSWORD_MIN_LENGTH=12

# ============ Email ============
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@auth.local
EMAIL_SECURE=false
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=1800

# ============ CORS / security ============
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
TRUST_PROXY=true
COOKIE_DOMAIN=

# ============ Rate limiting (requests per window per key) ============
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT_PASSWORD=3
RATE_LIMIT_TOKEN=10
RATE_LIMIT_AUTHORIZE=10
RATE_LIMIT_API=120

# ============ Risk engine ============
RISK_FAILED_LOGINS_THRESHOLD=3
RISK_LOCKOUT_MINUTES=15
RISK_HIGH_SCORE_ACTION=mfa

# ============ Account lockout ============
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ============ MFA ============
MFA_ISSUER=Identity Platform
MFA_CHALLENGE_TTL=300

# ============ Service topology ============
AUTH_SERVER_URL=http://localhost:3001
RESOURCE_API_URL=http://localhost:3002

# ============ Bootstrap admin (seed script only) ============
ADMIN_EMAIL=admin@auth.local
ADMIN_PASSWORD=
