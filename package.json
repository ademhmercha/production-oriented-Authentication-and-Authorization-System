{
  "name": "identity-platform",
  "version": "1.0.0",
  "description": "Centralized identity platform: authorization server, zero-trust API gateway and protected resource API with OAuth2 + PKCE, OIDC, RBAC, TOTP MFA, Redis-backed rate limiting, risk engine and audit logging.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client && node dist/scripts/copy-static.js",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"--ignore-pattern\" \"**/frontend/**\"",
    "lint:frontend": "eslint \"src/apps/frontend/**/*.ts\"",
    "dev:auth": "tsx watch src/apps/auth-server/main.ts",
    "dev:gateway": "tsx watch src/apps/api-gateway/main.ts",
    "dev:resource": "tsx watch src/apps/resource-api/main.ts",
    "dev:frontend": "npm run build:client && tsx watch src/apps/frontend/main.ts",
    "start": "node dist/apps/auth-server/main.js",
    "start:gateway": "node dist/apps/api-gateway/main.js",
    "start:resource": "node dist/apps/resource-api/main.js",
    "start:frontend": "node dist/apps/frontend/main.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e --runInBand"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
